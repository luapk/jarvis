# Required. Your Anthropic API key. Read server-side only, never exposed to the
# browser. Set this in the Vercel project settings, not in a committed file.
ANTHROPIC_API_KEY=

# Optional. Overrides the model used for the live loop.
# Defaults to claude-haiku-4-5-20251001 (fast, cheap, vision-capable).
# Set to claude-sonnet-5 for richer lines when latency and cost matter less.
MODEL=
