# Required. Your Anthropic API key. Read server-side only, never exposed to the
# browser. Set this in the Vercel project settings, not in a committed file.
ANTHROPIC_API_KEY=

# Optional. Overrides the model used for the live loop.
# Defaults to claude-haiku-4-5-20251001 (fast, cheap, vision-capable).
# Set to claude-sonnet-5 for richer lines when latency and cost matter less.
MODEL=

# Optional. ElevenLabs API key for the installation-grade voice, read
# server-side only. If unset, the app falls back to the browser voice, so the
# demo works with only the Anthropic key.
ELEVENLABS_API_KEY=

# Optional. ElevenLabs voice ID. Defaults to the installation voice.
ELEVENLABS_VOICE_ID=

# Optional. ElevenLabs model. Defaults to eleven_multilingual_v2 (quality).
# Set to eleven_turbo_v2_5 for lower latency.
ELEVENLABS_MODEL_ID=
